{
  "name": "@context-plug/extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "icons": "node scripts/generate-icons.cjs",
    "prebuild": "npm run icons",
    "dev": "npm run icons && vite build --watch",
    "build": "vite build && npm run postbuild",
    "postbuild": "cp manifest.json dist/ && cp -r icons dist/"
  },
  "dependencies": {
    "@context-plug/shared": "*"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.254",
    "typescript": "^5.3.3",
    "vite": "^5.0.10"
  }
}

